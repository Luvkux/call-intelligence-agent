# Google Gemini API key (Required for LLM structured extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (Default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Hugging Face Access Token (Optional for pyannote.audio speaker diarization)
HF_TOKEN=your_huggingface_token_here

# SQLite Database Location
DATABASE_URL=sqlite:///./data/call_intelligence.db
